<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 🔹 Sombra inferior suave -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A000000"/> <!-- sombra semitransparente -->
            <corners android:bottomLeftRadius="32dp" android:bottomRightRadius="32dp"/>
        </shape>
    </item>

    <!-- 🔹 Fondo principal con degradado -->
    <item android:bottom="4dp"> <!-- pequeño margen para la sombra -->
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1565C0"
                android:centerColor="#1E88E5"
                android:endColor="#42A5F5"
                android:angle="270"/>
            <corners
                android:bottomLeftRadius="32dp"
                android:bottomRightRadius="32dp"/>
        </shape>
    </item>

</layer-list>
