<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:padding="20dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Título principal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recuperar contraseña"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="28sp"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"/>

        <!-- Línea divisoria -->
        <View
            android:layout_width="80dp"
            android:layout_height="2dp"
            android:background="@color/primario"
            android:layout_marginBottom="20dp"/>

        <!-- Texto informativo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingresa tu correo electrónico, número de DNI y una nueva contraseña para restablecer el acceso a tu cuenta CarriShop."
            android:textColor="@color/texto"
            android:textSize="15sp"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="20dp"/>

        <!-- Campo de correo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Correo electrónico"
            android:textStyle="bold"
            android:textColor="@color/texto"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingresa tu correo electrónico"
            app:endIconDrawable="@drawable/ic_email"
        app:endIconTint="@color/primario">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/txtEmailRecuperar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"/>
    </com.google.android.material.textfield.TextInputLayout>


    <!-- Campo de DNI -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Número de DNI"
            android:textStyle="bold"
            android:textColor="@color/texto"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingresa tu número de DNI">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtDniRecuperar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="8"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Nueva contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nueva contraseña"
            android:textStyle="bold"
            android:textColor="@color/texto"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingresa tu nueva contraseña"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtNuevaContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Repetir contraseña -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Repetir contraseña"
            android:textStyle="bold"
            android:textColor="@color/texto"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"/>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Vuelve a escribir la contraseña"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtRepetirContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón actualizar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActualizarContrasena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Actualizar contraseña"
            android:textAllCaps="false"
            android:textColor="@color/on_primario"
            android:backgroundTint="@color/primario"
            app:cornerRadius="25dp"
            android:layout_marginTop="24dp"/>

        <!-- Botón volver -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver al inicio de sesión"
            android:textAllCaps="false"
            android:textColor="@color/primario"
            android:backgroundTint="@android:color/white"
            app:strokeColor="@color/primario"
            app:strokeWidth="2dp"
            app:cornerRadius="25dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
