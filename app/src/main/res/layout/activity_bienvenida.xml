<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <!-- Banda superior con degradado -->
    <View
        android:id="@+id/heroTop"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@drawable/bg_hero" />

    <!-- Contenido -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <!-- TARJETA DE BIENVENIDA -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:translationY="-20dp"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:cardElevation="10dp"
                app:cardBackgroundColor="@color/fondo_suave"
                app:strokeColor="@color/borde"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="20dp">

                    <!-- Imagen animada con Glide (más grande y sin espacio inferior) -->
                    <ImageView
                        android:id="@+id/imgBienvenida"
                        android:layout_width="260dp"
                        android:layout_height="260dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/app_name"
                        android:scaleType="centerInside"
                        android:layout_marginBottom="4dp"/>

                    <!-- Título -->
                    <TextView
                        android:id="@+id/txtTituloBienvenida"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="BIENVENIDO"
                        android:textStyle="bold"
                        android:textSize="22sp"
                        android:letterSpacing="0.02"
                        android:textColor="@color/texto"
                        android:gravity="center"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="2dp"/>

                    <!-- Nombre del usuario -->
                    <TextView
                        android:id="@+id/txtNombreBienvenida"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="NOMBRE APELLIDO"
                        android:textStyle="bold"
                        android:textSize="19sp"
                        android:letterSpacing="0.02"
                        android:textColor="@color/texto"
                        android:gravity="center"
                        android:layout_marginBottom="4dp"/>

                    <!-- Subtítulo -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="COMIENZA A ESCANEAR TUS PRODUCTOS"
                        android:textSize="13sp"
                        android:textColor="#666666"
                        android:gravity="center"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"/>

                    <!-- Botón primario (celeste) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIniciarCompra"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="iniciar a comprar"
                        android:textAllCaps="false"
                        android:textColor="@color/on_primario"
                        android:textSize="15sp"
                        android:background="@drawable/bg_btn_primary"
                        app:backgroundTint="@null"
                        app:rippleColor="@color/primario_oscuro"
                        app:cornerRadius="28dp" />

                    <!-- Botón secundario (blanco con borde celeste) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnListaMercado"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:text="@string/lista_titulo"
                        android:textAllCaps="false"
                        android:textColor="@color/primario"
                        android:textSize="15sp"
                        android:background="@drawable/bg_btn_secondary"
                        app:backgroundTint="@null"
                        app:rippleColor="@color/primario"
                        app:cornerRadius="28dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarBienvenida"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            app:navigationIcon="@drawable/ic_mas"
            app:navigationIconTint="@android:color/white"
            app:titleTextColor="@android:color/white"
            app:contentInsetStartWithNavigation="16dp"
            app:menu="@menu/menu_bienvenida"
            app:title="" />
    </com.google.android.material.appbar.AppBarLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
