<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:padding="16dp"
    tools:context=".ActividadControlCompras">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 🔷 Título -->
        <TextView
            android:id="@+id/titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Control de Compras Premium"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/primario"
            android:paddingBottom="10dp" />

        <!-- 🔄 Selector de Modo -->
        <Spinner
            android:id="@+id/spnModoGrafico"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:spinnerMode="dropdown"
            android:entries="@array/modos_grafico" />

        <!-- 📊 Tarjeta del gráfico -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/superficie"
            app:strokeColor="@color/borde"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/chartCompras"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:background="@drawable/bg_soft_blue"
                    android:elevation="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 🧾 Historial -->
        <TextView
            android:id="@+id/txtHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Historial de compras"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="@color/texto"
            android:layout_marginTop="16dp"
            android:paddingBottom="6dp" />

        <!-- 🗂️ Lista -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/superficie"
            app:strokeColor="@color/borde"
            app:strokeWidth="1dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                tools:listitem="@layout/item_historial_compra" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
