<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 🔹 Encabezado superior con botón atrás -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarPremiumTabs"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/blanco"
        android:elevation="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:title="Carrishop Rewards"
        app:titleTextColor="@color/black"
        app:navigationIcon="@drawable/ic_back_arrow" />

    <!-- 🔸 Línea divisoria bajo toolbar -->
    <View
        android:id="@+id/dividerToolbar"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#000000" />

    <!-- 🌟 Banner promocional tipo Starbucks Rewards -->
    <LinearLayout
        android:id="@+id/bannerPremium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_banner_premium"
        android:padding="16dp"
        android:layout_marginBottom="4dp"
        android:elevation="2dp">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_premium_banner"
            android:contentDescription="@null"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/txtMensajeBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="¡Sigue acumulando estrellas y desbloquea tus recompensas exclusivas! ☕"
            android:textColor="@color/white"
            android:textSize="15.5sp"
            android:lineSpacingExtra="2dp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 🔹 Pestañas de navegación -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutPremium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:tabIndicatorColor="@color/primario"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="@color/primario"
        app:tabTextColor="@color/texto_secundario"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabRippleColor="@android:color/transparent"
        android:elevation="2dp" />

    <!-- 🔹 Contenedor principal (fragmentos) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerPremium"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never" />

</LinearLayout>
