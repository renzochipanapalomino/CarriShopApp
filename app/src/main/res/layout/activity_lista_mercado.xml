<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    tools:context=".ActividadListaMercado">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarLista"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/primario"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:navigationIcon="@drawable/ic_back_arrow"
        app:title="@string/lista_titulo"
        app:titleCentered="false" />

    <LinearLayout
        android:id="@+id/contenedorCampos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_item_row_color"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarLista"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtSuperTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lista_super_titulo"
            android:textColor="@color/texto"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lytSuper"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <AutoCompleteTextView
                android:id="@+id/autoSupermercados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lytProducto"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/lista_hint_producto">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtProducto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgregarProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/lista_btn_agregar"
            android:textAllCaps="false"
            app:cornerRadius="24dp"
            app:backgroundTint="@color/primario"
            android:textColor="@color/on_primario"/>
    </LinearLayout>

    <TextView
        android:id="@+id/txtEmpty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/lista_sin_items"
        android:textColor="@color/texto_secundario"
        android:gravity="center"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/contenedorCampos"
        app:layout_constraintBottom_toTopOf="@id/grupoBotones"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0"
        tools:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerLista"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/contenedorCampos"
        app:layout_constraintBottom_toTopOf="@id/grupoBotones"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_lista_mercado"/>

    <LinearLayout
        android:id="@+id/grupoBotones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuardarLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lista_btn_guardar"
            android:textAllCaps="false"
            app:backgroundTint="@color/primario"
            app:cornerRadius="24dp"
            android:textColor="@color/on_primario"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIrVoz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/lista_btn_ir_voz"
            android:textAllCaps="false"
            app:backgroundTint="@color/boton_secundario"
            app:cornerRadius="24dp"
            android:textColor="@color/primario"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
