<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- 👋 Saludo -->
            <TextView
                android:id="@+id/txtBienvenido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bienvenido, Usuario"
                android:textColor="@color/texto"
                android:textStyle="bold"
                android:textSize="20sp"
                android:gravity="start"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp" />

            <!-- 🔹 Línea divisoria -->
            <View
                android:id="@+id/lineaDivisoria"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gris_claro"
                android:layout_marginBottom="10dp" />

            <!-- 💎 Encabezado Premium -->
            <LinearLayout
                android:id="@+id/encabezadoPremium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_premium_moderno"
                android:padding="18dp"
                android:elevation="2dp"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/txtTituloPuntos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estrellas acumuladas"
                    android:textStyle="bold"
                    android:textColor="@color/texto"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txtPuntosActuales"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_marginTop="4dp" />

                <ProgressBar
                    android:id="@+id/barraProgresoPuntos"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:max="300"
                    android:progress="0"
                    android:progressTint="@color/primario"
                    android:backgroundTint="@color/gris_claro"
                    android:layout_marginTop="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="6dp"
                    android:weightSum="5">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="25" android:textSize="12sp" android:gravity="center" android:textColor="@color/texto_secundario"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="50" android:textSize="12sp" android:gravity="center" android:textColor="@color/texto_secundario"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="100" android:textSize="12sp" android:gravity="center" android:textColor="@color/texto_secundario"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="200" android:textSize="12sp" android:gravity="center" android:textColor="@color/texto_secundario"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="300" android:textSize="12sp" android:gravity="center" android:textColor="@color/texto_secundario"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVerificarPuntos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ir a Carrishop Rewards"
                    android:textAllCaps="false"
                    android:textColor="@color/primario_oscuro"
                    android:backgroundTint="@color/white"
                    android:layout_marginTop="10dp"
                    app:cornerRadius="50dp"
                    app:strokeColor="@color/primario"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- 🔹 Descripción (solo para básico) -->
            <TextView
                android:id="@+id/txtDescripcionBasico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Explora tus supermercados favoritos y accede a beneficios exclusivos de Carrishop Premium."
                android:textColor="@color/texto_secundario"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="10dp" />

            <!-- 🌟 Botón Premium (solo para básicos) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPremium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ir a Carrishop Premium"
                android:textAllCaps="false"
                android:textColor="@color/on_primario"
                android:textSize="15sp"
                android:backgroundTint="@color/primario"
                android:layout_marginBottom="16dp"
                app:cornerRadius="24dp" />

            <!-- 🛒 Lista de supermercados -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaSupermercados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:layout_marginTop="8dp" />

            <!-- 🚪 Botón Salir -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSalir"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Salir"
                android:textAllCaps="false"
                android:textColor="@color/on_primario"
                android:backgroundTint="@color/acento"
                android:textSize="15sp"
                android:layout_marginTop="18dp"
                app:cornerRadius="24dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
