<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="20dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 🔹 Título -->
        <TextView
            android:id="@+id/txtTituloComoFunciona"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_como_funciona"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="10dp" />

        <!-- 🔹 Subtítulo -->
        <TextView
            android:id="@+id/txtSubtituloComoFunciona"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/subtitulo_como_funciona"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="25dp" />

        <!-- 🔹 Tarjeta 1 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="15dp"
            android:background="@drawable/bg_card_premium"
            android:layout_marginBottom="15dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_estrella_llena"
                android:layout_marginEnd="15dp"
                android:contentDescription="@null" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/txtTituloPaso1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/paso1_titulo"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="17sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/txtDescPaso1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/paso1_desc"
                    android:textColor="@color/black"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 🔹 Tarjeta 2 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="15dp"
            android:background="@drawable/bg_card_premium"
            android:layout_marginBottom="15dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_estrella_media"
                android:layout_marginEnd="15dp"
                android:contentDescription="@null" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/txtTituloPaso2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/paso2_titulo"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="17sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/txtDescPaso2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/paso2_desc"
                    android:textColor="@color/black"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 🔹 Tarjeta 3 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="15dp"
            android:background="@drawable/bg_card_premium">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_estrella_vacia"
                android:layout_marginEnd="15dp"
                android:contentDescription="@null" />

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/txtTituloPaso3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/paso3_titulo"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="17sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/txtDescPaso3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/paso3_desc"
                    android:textColor="@color/black"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
