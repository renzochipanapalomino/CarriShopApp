<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FDF9"
    android:padding="16dp"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- 🟢 Saludo -->
        <TextView
            android:id="@+id/txtSaludoUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Marcos Choque, conoce qué puedes canjear con tus Estrellas"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_marginBottom="18dp" />

        <!-- ⭐ Rangos de estrellas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView android:text="25★" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"/>
            <TextView android:text="50★" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"/>
            <TextView android:text="100★" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"/>
            <TextView android:text="200★" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"/>
            <TextView android:text="300★" android:textSize="14sp"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"/>
        </LinearLayout>

        <!-- 🥐 Imagen grande de recompensa -->
        <ImageView
            android:id="@+id/imgRecompensa"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_recompensa_fondo"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:src="@drawable/prod_pan" />

        <!-- 🍞 Título de recompensa -->
        <TextView
            android:id="@+id/txtTituloRecompensa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Empieza tu viaje de recompensas 🥖"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <!-- Descripción -->
        <TextView
            android:id="@+id/txtDescripcionRecompensa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acumula 25 estrellas para obtener tu primera recompensa."
            android:textColor="@color/texto"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <!-- 🔘 Botón para canjear puntos -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCanjearEstrellas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Canjear mis Estrellas ⭐"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/primario"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="24dp"
            android:padding="10dp"
            android:elevation="3dp" />

    </LinearLayout>
</ScrollView>
