<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="12dp"
    android:background="@color/fondo_suave"
    android:padding="12dp"
    android:elevation="4dp">

    <ImageView
        android:id="@+id/imgFondoSuper"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:background="@color/black"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/txtNombreSuper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre del Supermercado"
        android:textStyle="bold"
        android:textColor="@color/texto"
        android:textSize="18sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/txtDescripcionSuper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Descripción del supermercado"
        android:textColor="@color/texto"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIngresar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ingresar a tienda"
        android:textAllCaps="false"
        android:textColor="@color/on_primario"
        android:textSize="15sp"
        android:backgroundTint="@color/primario"
        app:cornerRadius="25dp"
        android:paddingHorizontal="24dp"
        android:layout_gravity="center" />
</LinearLayout>
