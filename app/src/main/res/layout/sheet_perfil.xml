<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 🔹 Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/t_mi_perfil"
            android:textStyle="bold"
            android:textColor="@color/texto"
            android:textSize="14sp" />

        <!-- Línea divisoria -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:background="@color/borde" />

        <!-- 🔹 Imagen de usuario -->
        <ImageView
            android:id="@+id/imgAvatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_user"
            app:tint="@color/texto"
            android:contentDescription="@string/desc_avatar"
            android:layout_gravity="center_horizontal" />

        <!-- 🔹 Nombre -->
        <TextView
            android:id="@+id/txtNombrePerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/t_nombre_apellido"
            android:textStyle="bold"
            android:textColor="@color/texto"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <!-- 🔹 Email -->
        <TextView
            android:id="@+id/txtEmailPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/t_usuario_correo_demo"
            android:textColor="#666666"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- 🔹 Botón General -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGeneral"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/t_general"
            android:textAllCaps="false"
            android:textColor="@color/texto"
            app:icon="@drawable/ic_settings"
            app:iconPadding="8dp"
            app:cornerRadius="24dp"
            app:strokeColor="@color/borde"
            app:strokeWidth="1dp" />

        <!-- 🔹 Botón Alertas -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAlertas"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/t_alertas_productos"
            android:textAllCaps="false"
            android:textColor="@color/texto"
            app:icon="@drawable/ic_bell"
            app:iconPadding="8dp"
            app:cornerRadius="24dp"
            app:strokeColor="@color/borde"
            app:strokeWidth="1dp" />

        <!-- 🔹 Botón Modo Niños -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModoNinos"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/t_modo_ninos"
            android:textAllCaps="false"
            android:textColor="@color/texto"
            app:icon="@drawable/ic_kids"
            app:iconPadding="8dp"
            app:cornerRadius="24dp"
            app:strokeColor="@color/borde"
            app:strokeWidth="1dp" />

        <!-- 🔹 Botón Control de Compras (solo Premium) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnControlCompras"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Control de Compras"
            android:textAllCaps="false"
            android:textColor="@color/texto"
            app:icon="@drawable/ic_cart"
            app:iconPadding="8dp"
            app:cornerRadius="24dp"
            app:strokeColor="@color/borde"
            app:strokeWidth="1dp"
            android:visibility="gone" />

        <!-- 🟣 Botón Premium -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPremiumPerfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text=" CarriShop Premium"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/purple_500"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_crown"
            app:iconPadding="8dp"
            app:iconGravity="textStart"
            app:strokeWidth="0dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
