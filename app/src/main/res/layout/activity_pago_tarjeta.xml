<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="20dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 🔹 Título -->
        <TextView
            android:id="@+id/txtTituloPago"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/t_tarjeta_titulo"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <!-- 🔹 Subtítulo con logos -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/t_numero_tarjeta"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="20dp"
                android:layout_marginStart="10dp"
                android:src="@drawable/visa"
                android:contentDescription="@string/t_logo_visa" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/mastercard"
                android:contentDescription="@string/t_logo_mastercard" />

            <ImageView
                android:layout_width="30dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/amex"
                android:contentDescription="@string/t_logo_amex" />
        </LinearLayout>

        <!-- 🔹 Número de tarjeta -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:boxBackgroundMode="none">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtNumeroTarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/t_hint_numero_tarjeta"
                android:inputType="number"
                android:textColorHint="#AAAAAA"
                android:textColor="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Línea divisoria -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="#E0E0E0" />

        <!-- 🔹 Fecha caducidad y CVV -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:boxBackgroundMode="none">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtFechaTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/t_hint_fecha"
                    android:inputType="text"
                    android:textColorHint="#AAAAAA"
                    android:textColor="@color/black" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                app:boxBackgroundMode="none">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/txtCvvTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/t_hint_cvv"
                    android:inputType="numberPassword"
                    android:textColorHint="#AAAAAA"
                    android:textColor="@color/black" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- 🔹 Titular -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:boxBackgroundMode="none">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtTitularTarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/t_hint_titular"
                android:inputType="textPersonName"
                android:textColorHint="#AAAAAA"
                android:textColor="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 🔹 Correo -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:boxBackgroundMode="none">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txtCorreoTarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/t_hint_correo"
                android:inputType="textEmailAddress"
                android:textColorHint="#AAAAAA"
                android:textColor="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 🔹 Checkbox guardar tarjeta -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_check_red"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/t_guardar_tarjeta" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/t_guardar_tarjeta"
                android:textColor="@color/black"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 🔹 Texto de política -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/t_politica_seguridad"
            android:textColor="#777777"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp" />

        <!-- 🔹 Total -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:text="@string/t_total"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtTotalPago"
                android:text="PEN 9.90"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 🔹 Botón confirmar -->
        <Button
            android:id="@+id/btnConfirmarPago"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="@string/t_confirmar"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F04242"
            android:layout_marginTop="12dp"
            android:enabled="false" />
    </LinearLayout>
</ScrollView>
