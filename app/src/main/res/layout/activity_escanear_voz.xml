<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_soft_blue"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    tools:ignore="Typos">

    <!-- HEADER degradado -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerCard"
        android:layout_width="0dp"
        android:layout_height="150dp"
        app:cardCornerRadius="22dp"
        app:cardUseCompatPadding="false"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:strokeColor="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_header_gradient"
            android:padding="12dp">

            <!-- Texto principal -->
            <TextView
                android:id="@+id/txtTituloVoz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voz_presionar"
                android:textColor="@color/on_primario"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <!-- Nombre del supermercado -->
            <TextView
                android:id="@+id/txtSupermercado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Supermercado"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="26sp"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp" />

            <!-- Subtítulo -->
            <TextView
                android:id="@+id/txtSubVoz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voz_menciona"
                android:textColor="@color/on_primario"
                android:textSize="14sp"
                android:gravity="center" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tarjeta del micrófono -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMic"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/superficie"
        app:strokeColor="@color/borde"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/headerCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btnMic"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/ripple_circle_primary"
                android:contentDescription="@null"
                android:padding="26dp"
                android:src="@drawable/ic_mic_24"
                app:tint="@color/primario"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/voz_toca_hablar"
                android:textColor="@color/texto"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Lista de productos -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLista"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/superficie"
        app:strokeColor="@color/borde"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/cardMic"
        app:layout_constraintBottom_toTopOf="@id/btnAgregarCarrito"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/voz_lista_productos"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="@color/texto"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="@color/borde"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerVoz"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingTop="6dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Botón principal -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAgregarCarrito"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="@string/voz_agregar_carrito"
        android:textAllCaps="false"
        android:textColor="@color/on_primario"
        android:textSize="15sp"
        app:backgroundTint="@color/primario"
        app:rippleColor="@color/primario_oscuro"
        app:cornerRadius="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
