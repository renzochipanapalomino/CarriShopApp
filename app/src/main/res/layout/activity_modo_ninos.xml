<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FBFF"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imgSync"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_kids"
        android:contentDescription="Sincronización exitosa"
        app:tint="@color/azul_bronce" />

    <TextView
        android:id="@+id/txtSync"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sincronización exitosa"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/texto"
        android:layout_marginTop="16dp" />

</LinearLayout>
